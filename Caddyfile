{$API_HOST} {
  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-Robots-Tag "noindex, nofollow"
    Referrer-Policy "no-referrer"
    -Server
  }

  @privateApi path /api/*
  header @privateApi Cache-Control "no-store"

  @auth path /api/v1/auth/*
  handle @auth {
    reverse_proxy incident-service:8082
  }

  @incidents {
    method GET
    path /api/v1/incidents /api/v1/incidents/*
  }
  handle @incidents {
    reverse_proxy incident-service:8082
  }

  handle /health {
    header Content-Type "application/json"
    respond `{"status":"ok","service":"causora-api"}` 200
  }

  handle {
    reverse_proxy frontend:3000
  }
}
