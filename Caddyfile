{$API_HOST} {
  encode gzip zstd

  header {
    Access-Control-Allow-Origin "https://varad11102.github.io"
    Access-Control-Allow-Methods "GET, OPTIONS"
    Access-Control-Allow-Headers "Content-Type"
    Vary "Origin"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-Robots-Tag "noindex, nofollow"
    Referrer-Policy "no-referrer"
    -Server
  }

  @preflight method OPTIONS
  handle @preflight {
    respond 204
  }

  @incidents {
    method GET
    path /api/v1/incidents /api/v1/incidents/*
  }
  handle @incidents {
    reverse_proxy incident-service:8082
  }

  handle / {
    header Content-Type "application/json"
    respond `{"service":"causora-api","status":"ok","health":"/health","incidents":"/api/v1/incidents"}` 200
  }

  handle /health {
    header Content-Type "application/json"
    respond `{"status":"ok","service":"causora-api"}` 200
  }

  handle {
    respond 404
  }
}
